[Unit]
Description=Pi Slideshow network and restart administration
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
ExecStart=/usr/bin/python3 -u /opt/pi-slideshow/deploy/admin_service.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=pi-slideshow-admin
RuntimeDirectoryMode=0755
UMask=0077

[Install]
WantedBy=multi-user.target
