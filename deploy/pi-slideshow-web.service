[Unit]
Description=Pi Slideshow web controls and playback clock
Wants=pi-slideshow-admin.service
After=pi-slideshow-admin.service

[Service]
User=slideshow
Group=slideshow
WorkingDirectory=/opt/pi-slideshow
ExecStart=/usr/bin/python3 /opt/pi-slideshow/run.py
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pi-slideshow /media/slideshow
ProtectHome=true
UMask=0022

[Install]
WantedBy=multi-user.target
